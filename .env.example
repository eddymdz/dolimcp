# Dolibarr Docker (copy to .env)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=dolidb
MYSQL_USER=dolidbuser
MYSQL_PASSWORD=dolidbpass

DOLI_INIT_DEMO=1
DOLI_URL_ROOT=http://localhost:8081
DOLI_ADMIN_LOGIN=admin
DOLI_ADMIN_PASSWORD=admin
DOLI_COMPANY_NAME=Demo Company
DOLI_COMPANY_COUNTRYCODE=US
DOLI_ENABLE_MODULES=Api,Projet,User,Hrm

# Host port for Dolibarr (change if already in use)
DOLI_HTTP_PORT=8081

# For Cursor mcp.json — MCP token from user tab "MCP token" (not the official REST API key)
DOLIBARR_MCP_TOKEN=
